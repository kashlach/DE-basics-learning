      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Тепловая карта изменения курса валют",
          "description": "В какие дни недели валюты чаще растут или падают (среднее за 90 дней)",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "uid": "currency_postgres"
                      },
                      "spec": {
                        "dataset": "currency_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    char_code AS \"Валюта\",\r\n    CASE EXTRACT(dow FROM requested_date) \r\n      WHEN 0 THEN 'Вс'\r\n      WHEN 1 THEN 'Пн'\r\n      WHEN 2 THEN 'Вт'\r\n      WHEN 3 THEN 'Ср'\r\n      WHEN 4 THEN 'Чт'\r\n      WHEN 5 THEN 'Пт'\r\n      WHEN 6 THEN 'Сб'\r\n    END AS \"День недели\",\r\n    AVG(daily_change_pct) AS avg_change\r\nFROM finance_int.int_daily_rates\r\nWHERE requested_date >= NOW() - INTERVAL '90 days'\r\n  AND char_code IN ('USD', 'EUR', 'EGP', 'THB', 'TRY', 'VND')\r\nGROUP BY char_code, EXTRACT(dow FROM requested_date)\r\nORDER BY char_code,\r\n         CASE EXTRACT(dow FROM requested_date)\r\n         WHEN 0 THEN 7\r\n         ELSE EXTRACT(dow FROM requested_date)\r\n         END;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "groupingToMatrix",
                  "spec": {
                    "options": {
                      "columnField": "День недели",
                      "rowField": "Валюта",
                      "valueField": "avg_change"
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
